# --- App ---
ENV=development
DEBUG=true

# --- Security ---
SECRET_KEY=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# --- LLM ---
# Choose "groq" or "gemini" — both have usable free tiers.
LLM_PROVIDER=groq

# Groq: get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
CONFIDENCE_THRESHOLD=0.55

# --- Embeddings / Vector DB ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/vectorstore
VECTOR_COLLECTION_NAME=support_knowledge_base
RETRIEVAL_TOP_K=4

# --- Database ---
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/support_agent
# DATABASE_URL=postgresql://postgres:pass1234@localhost:5432/customer-support-ai-agent
DATABASE_URL=postgresql+psycopg2://postgres:pass1234@localhost:5432/support_agent
